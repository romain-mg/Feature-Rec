# Copy to .env (or just export in your shell). Optional.
# Without a key, AutoDemo runs in offline mode using the known-good scene(s).
ANTHROPIC_API_KEY=

# Optional: override the replication model (default: claude-sonnet-4-6)
# AUTODEMO_MODEL=claude-sonnet-4-6

# Feature-Rec local demo service.
# Expose this service with ngrok/cloudflared and override the action's api-url in the demo repo.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# Explicit loopback HTTP is accepted only in development/test.
NODE_ENV=development
FEATURE_REC_BASE_URL=http://localhost:3000

# GitHub App credentials for creating Check Runs and PR comments.
# All service calls use the tenant's repository-scoped installation access.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

# Slack App credentials for uploading videos and handling buttons/modals.
SLACK_SIGNING_SECRET=
# Provision tenant Slack tokens through the compiled admin command's secret input.
# Exactly 32 random bytes encoded as base64 (`openssl rand -base64 32`).
# Required once encrypted tokens are stored in slack_workspaces.
FEATURE_REC_SLACK_TOKEN_ENCRYPTION_KEY=

# Optional hosted Slack OAuth credentials: leave all three empty to disable.
# SDK/configuration only for now; installation routes arrive in later B2 milestones.
# OAuth credentials are distinct from the app signing secret. Keep token rotation off.
# Register FEATURE_REC_BASE_URL + /api/slack/oauth/callback as the Slack redirect URL.
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# GitHub Actions workflows require permissions: id-token: write.
# The audience is the normalized FEATURE_REC_BASE_URL / action api-url.
GITHUB_OIDC_ISSUER=https://token.actions.githubusercontent.com
